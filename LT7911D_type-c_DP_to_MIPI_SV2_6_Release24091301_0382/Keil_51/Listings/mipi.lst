 625          void MipiRdDlyCal(void)
 626          {
 627   1              u32 rd_dly = 0;
 628   1              u16 rd_Hsw,rd_Hbp,rd_Hactive;
 629   1              u32 m,x,y = 0;
 630   1              u16 rdpixclk = 0;
 631   1              u16 rdbyteclk = 0;
 632   1      
 633   1              chip_write_i2c(0xA034,0x1A);
 634   1              DelayMs(10);    
 635   1              g_MipiByteClock = chip_read_i2c(0xB8B1);
 636   1              g_MipiByteClock = (g_MipiByteClock<<8)+ chip_read_i2c(0xB8B2);
 637   1              g_MipiByteClock = (g_MipiByteClock<<8)+ chip_read_i2c(0xB8B3);
 638   1              chip_write_i2c(0xA034,0x01);
 639   1              
 640   1              rdpixclk = g_TimingStr.PixelClock/1000/g_DisplayMode;
 641   1              rdbyteclk = g_MipiByteClock/1000;
 642   1              //printf("\n[PixClock]  : %d MHz\n", rdpixclk);
 643   1              rd_Hsw = g_TimingStr.Hsw/g_DisplayMode;
 644   1              rd_Hbp = g_TimingStr.Hbp/g_DisplayMode;
 645   1              rd_Hactive = g_TimingStr.Hactive/g_DisplayMode;
 646   1              //printf(" \n[H]  : Hsw:%d  Hbp:%d  Hactive :%d  \n",   rdhsw, rdhbp, rdhactive);
 647   1              
 648   1              m = rd_Hsw+rd_Hbp+rd_Hactive ;
 649   1              x = m * (rdbyteclk+1);
 650   1              y = x / (rdpixclk -1);
 651   1              
 652   1              if(g_MipiFormat == YUV422_8bit)
 653   1              {
 654   2              rd_dly = y - (2*rd_Hactive)/g_MipiSetStr.SetPortLaneNum ;
 655   2              }
 656   1              else if(g_MipiFormat == RGB888)
 657   1              {
 658   2              rd_dly = y - (3*rd_Hactive)/g_MipiSetStr.SetPortLaneNum ;
 659   2              }
 660   1              g_RdDly = rd_dly;               
 661   1      }
