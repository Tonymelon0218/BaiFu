 719   2              }
 720   1              else
 721   1              {
 722   2              MipiRdDlyCal();
 723   2              }
 724   1              ColorSpaceConversion();
 725   1              SyncPolAdjust();
 726   1              MipiProtocalSet();
 727   1              MipiVideoSet();
 728   1      }
