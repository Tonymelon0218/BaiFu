 663          void MipiVideoSet(void)
 664          {
 665   1              chip_write_i2c(0xC21C,0x00);
 666   1              switch(g_MipiSetStr.SetPortLaneNum)
 667   1                      {
 668   2                      case 4:
 669   2                              chip_write_i2c(0xC201,0x00|g_MipiSetStr.SetVideoMode|g_MipiType);
 670   2                              chip_write_i2c(0xC256,0x00|g_MipiSetStr.SetVideoMode|g_MipiType);
 671   2                              chip_write_i2c(0xC202,0x01);
 672   2                              chip_write_i2c(0xC203,0x55);
C51 COMPILER V9.60.0.0   MIPI                                                              11/26/2025 11:55:36 PAGE 12  

 673   2                              break;
 674   2                      case 3:
 675   2                              chip_write_i2c(0xC201,0x30|g_MipiSetStr.SetVideoMode|g_MipiType);
 676   2                              chip_write_i2c(0xC256,0x30|g_MipiSetStr.SetVideoMode|g_MipiType);
 677   2                              chip_write_i2c(0xC202,0x01);
 678   2                              chip_write_i2c(0xC203,0x90);                    
 679   2                              break;
 680   2                      case 2:
 681   2                              chip_write_i2c(0xC201,0x20|g_MipiSetStr.SetVideoMode|g_MipiType);
 682   2                              chip_write_i2c(0xC256,0x20|g_MipiSetStr.SetVideoMode|g_MipiType);
 683   2                              chip_write_i2c(0xC202,0x02);
 684   2                              chip_write_i2c(0xC203,0x58);                    
 685   2                              break;
 686   2                      case 1:
 687   2                              chip_write_i2c(0xC201,0x10|g_MipiSetStr.SetVideoMode|g_MipiType);
 688   2                              chip_write_i2c(0xC256,0x10|g_MipiSetStr.SetVideoMode|g_MipiType);
 689   2                              chip_write_i2c(0xC202,0x03);
 690   2                              chip_write_i2c(0xC203,0x00);                    
 691   2                              break;
 692   2                      }       
 693   1              DelayMs(20);
 694   1              chip_write_i2c(0xC200,g_MipiSetStr.SetClockMode);
 695   1              if(g_MipiType == DSI)//only DSI needs EOTP
 696   1              {
