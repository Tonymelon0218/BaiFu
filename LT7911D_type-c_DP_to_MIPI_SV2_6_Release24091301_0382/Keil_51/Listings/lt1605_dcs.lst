 800          void DcsPktWrite(u8 DCS_DI, u8 Len, u8* Ptr )
 801          {
 802                  u8 i=0;
 803                  chip_write_i2c(0xC21C,0x40); //Write enable;
 804                  if( Len == 2 )
 805                  {       
 806                          chip_write_i2c(0xC218,0x0C); //Hardware calculate ecc and crc&LP mode send pkt enable&Short pkt
 807                          chip_write_i2c(0xC219,0x04);
 808                          chip_write_i2c(0xC234,DCS_DI);
 809                          chip_write_i2c(0xC234,*Ptr);
 810                          chip_write_i2c(0xC234,*( Ptr + 1 ));
 811                          
 812                  }else
 813                  {
 814                          chip_write_i2c(0xC218,0x0E);
 815                          chip_write_i2c(0xC219,Len + 6);
 816                          chip_write_i2c(0xC234,DCS_DI);
 817                          chip_write_i2c(0xC234,Len);
 818                          chip_write_i2c(0xC234,0x00);
 819                          for( i = 0; i < Len; i++ )
 820                          {
 821                                  chip_write_i2c(0xC234,*Ptr);
 822                                  Ptr++;                                                                                                             
 823                          }
 824                  }
 825                  DelayMs(1);
 826                  chip_write_i2c(0xC218,0x00);
 827          
 828          }
 829          
 830          void InitPanel( void )
 831          {
 832             u8 dcslen=0,i=0;
 833             for(i=0;i<CMDNUM;i++)
 834             {
 835                          dcslen=cmdlen[i];//sizeof(dcs##CMDNUM(i));
 836                          if(dcslen==2)
 837                        DcsPktWrite(SPK_DI,dcslen, cmdlist[i]);//shot
 838                          else if(dcslen>2)
 839                           DcsPktWrite(LPK_DI,dcslen, cmdlist[i]);//long
 840                  }
 841                  DcsPktWrite( Sleep_Out[0], ( sizeof( Sleep_Out ) - 1 ), &Sleep_Out[1] );
 842                  DelayMs(150);
 843          //      DcsPktWrite( Set_address_mode[0], ( sizeof( Set_address_mode ) - 1 ), &Set_address_mode[1] );
 844          //      DelayMs(150);
 845          //      DcsPktWrite( Set_pixel_format[0], ( sizeof( Set_pixel_format ) - 1 ), &Set_pixel_format[1] );
 846                  DcsPktWrite( Display_On[0], ( sizeof( Display_On ) - 1 ), &Display_On[1] );
 847                  DelayMs(200);
 848          } 
