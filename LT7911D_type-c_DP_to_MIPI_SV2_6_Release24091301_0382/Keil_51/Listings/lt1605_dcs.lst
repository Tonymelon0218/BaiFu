 421          
 422          void DcsPktWrite(u8 DCS_DI, u8 Len, u8 *Ptr)
 423          {
 424   1              u8 i = 0;
 425   1              chip_write_i2c(0xC21C, 0x40); // Write enable;
 426   1              if (Len == 2)
C51 COMPILER V9.60.0.0   LT1605_DCS                                                        11/26/2025 11:55:36 PAGE 8   

 427   1              {
 428   2                      chip_write_i2c(0xC218, 0x0C); // Hardware calculate ecc and crc&LP mode send pkt enable&Short pkt
 429   2                      chip_write_i2c(0xC219, 0x04);
 430   2                      chip_write_i2c(0xC234, DCS_DI);
 431   2                      chip_write_i2c(0xC234, *Ptr);
 432   2                      chip_write_i2c(0xC234, *(Ptr + 1));
 433   2              }
 434   1              else
 435   1              {
 436   2                      chip_write_i2c(0xC218, 0x0E);
 437   2                      chip_write_i2c(0xC219, Len + 6);
 438   2                      chip_write_i2c(0xC234, DCS_DI);
 439   2                      chip_write_i2c(0xC234, Len);
 440   2                      chip_write_i2c(0xC234, 0x00);
 441   2                      for (i = 0; i < Len; i++)
 442   2                      {
 443   3                              chip_write_i2c(0xC234, *Ptr);
 444   3                              Ptr++;
 445   3                      }
 446   2              }
 447   1              DelayMs(1);
 448   1              chip_write_i2c(0xC218, 0x00);
 449   1      }
 450          
 451          void SSD_4P(u8 data1, u8 data2, u8 data3, u8 data4)
 452          {
 453   1              u8 i = 0;
 454   1              chip_write_i2c(0xC21C, 0x40); // Write enable;
 455   1      
 456   1              chip_write_i2c(0xC218, 0x0E);
 457   1              chip_write_i2c(0xC219, 4 + 6);
 458   1              chip_write_i2c(0xC234, 0x39);
 459   1              chip_write_i2c(0xC234, 4);
 460   1              chip_write_i2c(0xC234, 0x00);
 461   1      
 462   1              chip_write_i2c(0xC234, data1);
 463   1              chip_write_i2c(0xC234, data2);
 464   1              chip_write_i2c(0xC234, data3);
 465   1              chip_write_i2c(0xC234, data4);
 466   1      
 467   1              DelayMs(1);
 468   1              chip_write_i2c(0xC218, 0x00);
 469   1      }
 470          
 471          void SSD_Single(u8 data0, u8 data1)
 472          {
 473   1              chip_write_i2c(0xC21C, 0x40);
 474   1              chip_write_i2c(0xC218, 0x0C); // Hardware calculate ecc and crc&LP mode send pkt enable&Short pkt
 475   1              chip_write_i2c(0xC219, 0x04);
 476   1              chip_write_i2c(0xC234, 0x15);
 477   1              chip_write_i2c(0xC234, data0);
 478   1              chip_write_i2c(0xC234, data1);
 479   1              DelayMs(1);
 480   1              chip_write_i2c(0xC218, 0x00);
 481   1              DelayMs(10);
 482   1      }
