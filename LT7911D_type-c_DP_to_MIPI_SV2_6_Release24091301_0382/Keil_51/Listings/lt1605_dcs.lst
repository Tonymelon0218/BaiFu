 489   1              chip_write_i2c(0xC234, 0x05);
 490   1              chip_write_i2c(0xC234, data0);
 491   1              chip_write_i2c(0xC234, 0x00);
 492   1              DelayMs(1);
 493   1              chip_write_i2c(0xC218, 0x00);
 494   1              DelayMs(10);
 495   1      }
