 484          void SSD_0P(u8 data0)
 485          {
 486   1              chip_write_i2c(0xC21C, 0x40);
 487   1              chip_write_i2c(0xC218, 0x0C); // Hardware calculate ecc and crc&LP mode send pkt enable&Short pkt
 488   1              chip_write_i2c(0xC219, 0x04);
